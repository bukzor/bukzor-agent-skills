#!/bin/bash
# The grounding ranking as a table: llm-claims-kb-grounding | jq | column.
# `users` counts the owner claims reached; their labels are in the JSON.
# Usage: llm-claims-kb-grounding [--json] <name>.claims.kb
#   --json  the console script's raw JSONL, one record per claim, unformatted
set -euo pipefail
shopt -s failglob
export DEBUG="${DEBUG:-0}"

onerror() {
  error="$?"
  echo >&2 "ERROR($error)"
  exit "$error"
}
trap onerror ERR

here="$(dirname -- "$(readlink -f -- "$0")")"
# Absolute venv path: a script-to-script call shouldn't depend on the
# caller's shell having .venv/bin on PATH.
raw="$here/../../.venv/bin/llm-claims-kb-grounding"

if (( DEBUG > 0 )); then
  set -x
fi

if [[ "${1:-}" == --json ]]; then
  shift
  exec "$raw" "$@"
fi

{
  printf 'label\tstanding\teffective\trests\tweakest\tusers\tforeign\tdangling\n'
  "$raw" "$@" |
    jq -r '[
      .label, .standing, .effective, .rests_on_it,
      (if .is_judge then "self" else (.weakest | join(",")) end),
      (.user_grounds | length), .foreign, .dangling
    ] | map(if . == "" then "-" else . end) | @tsv'
} | column -t -s $'\t'
