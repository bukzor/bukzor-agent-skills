#!/bin/bash
set -euo pipefail
export DEBUG="${DEBUG:-0}"

onerror() {
  error="$?"
  echo >&2 "ERROR($error)"
  exit "$error"
}
trap onerror ERR

# Run as a real module (`python -m`), not a parentless script -- gives it a
# correct __package__ so its own `from .ledger import ...` just works. No cd:
# the module globs `*.claims.kb` from the caller's cwd (run from the repo root).
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if (( DEBUG > 0 )); then
  set -x
fi

exec env PYTHONPATH="$here/../lib/python${PYTHONPATH:+:$PYTHONPATH}" \
  uv run python -m llm_claims_kb.mentions "$@"
