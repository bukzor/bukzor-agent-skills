#!/bin/bash
set -euo pipefail
export DEBUG="${DEBUG:-0}"

onerror() {
  error="$?"
  echo >&2 "ERROR($error)"
  exit "$error"
}
trap onerror ERR

# Run as a real module (`python -m`), not a parentless script -- gives it a
# correct __package__ so its own `from .ledger import ...` just works. No cd:
# the module globs `*.claims.kb` from the caller's cwd (run from the repo root).
# That's also why this invokes the workspace venv's python directly rather
# than `uv run`: `uv run` resolves its project from the caller's cwd too, so
# without a cd to anchor it, it's one `cd` away from silently resolving
# against the wrong project (or none). The venv python is already the right
# interpreter with llm_claims_kb installed editable.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if (( DEBUG > 0 )); then
  set -x
fi

exec "$here/../../.venv/bin/python" -m llm_claims_kb.ownership "$@"
