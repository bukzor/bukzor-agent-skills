#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = ["pyyaml"]
# ///
"""Flatten a file-per-claim ledger to the one-line-per-claim chat form.

The output is one nested list to paste into claude.ai, where there are no
files to walk and `Skill(llm-claims)`'s core notation is the whole system:
`* LABEL <- PRIOR PRIOR: text`, sigils trailing. Everything the directory
carries structurally comes back as notation -- `standing:` as the sigil,
`verdict:` as a strike through the label, `why:` as the arrows, each
target's sigil computed at the reference site so the warrant-mix shows where
the weight rests, `verify:` as `-- certified(CHECK)`, and the tree as
indentation, each theory's claims written under the claim that defines it.

Siblings come in support order, so a line's premises stand above it as well
as outside it. The whole ledger is rendered, never a slice of one -- a
partial render would read as the ledger's full state and silently retract
what it omitted.

Lints, on stderr: a `why:` pointing nowhere, a defining claim stipulating
no ontology, two labels `grep` cannot tell apart. A theory nobody has
defined yet is not a lint -- it renders `?`, like any unsigned claim.
"""

import argparse
import re
import sys
from collections.abc import Iterable, Mapping
from datetime import date
from itertools import combinations
from pathlib import Path
from typing import cast

from llm_claims_kb import (
    Claim,
    Ledger,
    Prior,
    Theory,
    claim_id,
    dangling,
    defining_claim,
    foreign,
    read_ledger,
)

# A claim file as a claim body cites one: `foo.md`, `../bar.kb/foo.md`.
CITE = re.compile(r"(?:\.\./)*(?:[a-z0-9-]+\.kb/)?[a-z0-9-]+\.md")

# Enough notation to act on the paste without the skill loaded: a ledger's
# own FRESH_READER and SELF_CONTAINED claims apply to the ledger's transport
# form too.
LEGEND = (
    "Notation (`Skill(llm-claims)`): one claim per line; `LABEL` names the locus"
    " of contention, a trailing sigil signs the judge -- `!` the user's call,"
    " `+` the agent's (veto invited), `?` no one's yet, bare means none is"
    " needed -- and a struck label, `~~LABEL!~~`, is a judgment that went"
    " against the claim; `<-` names what the claim rests"
    " on. Indentation nests: a claim"
    " reads in every word stipulated above it, and a claim stipulating an"
    " `ontology:` is a theory -- what is indented under it is confined to"
    " those words. Union over the chat, last wins."
)


def in_support_order(deps: Mapping[str, tuple[str, ...]]) -> tuple[str, ...]:
    """Keys ordered so a dependency precedes its dependents, ties by name.

    Not a plain topological sort: a ledger may legally cite in a cycle, so
    what no order can place gets placed by name rather than dropped.
    """
    pending = dict(deps)
    ordered: list[str] = []
    while pending:
        ready = sorted(
            key for key, on in pending.items() if not set(on) & pending.keys()
        )
        ready = ready or [min(pending)]  # a citation cycle: name order breaks it
        for key in ready:
            del pending[key]
        ordered.extend(ready)
    return tuple(ordered)


def arrows(why: Iterable[Prior], labels: Mapping[str, str]) -> str:
    """The ` <- ` clause: cited claims by label, each carrying its own sigil."""
    cited = " ".join(labels.get(prior.id, f"(missing: {prior.id})") for prior in why)
    return f" <- {cited}" if cited else ""


def relabel(text: str, claim: Claim, root: Path, labels: Mapping[str, str]) -> str:
    """Prose cites of claim files, read back as labels: the paste has no files.

    A cite naming no claim of this ledger and no file either is left as
    written: a filename says more there than nothing does.
    """
    return CITE.sub(
        lambda cite: labels.get(claim_id(root, claim.path.parent / cite[0]), cite[0]),
        text,
    )


def claim_line(claim: Claim, root: Path, labels: Mapping[str, str]) -> str:
    """One claim, one line without its bullet -- the caller owns the indent.

    A defining claim differs only in what it has to suffix: the word list it
    stipulates, and the observation that would void its stamp.
    """
    notes = [f"ontology: {', '.join(claim.ontology)}"] if claim.ontology else []
    notes += [f"stale when {claim.stale_when}"] if claim.stale_when else []
    notes += [f"certified({claim.verify})"] if claim.verify else []
    notes += [f"authority: {claim.authority}"] if claim.authority else []
    suffix = "".join(f" -- {note}" for note in notes)
    gist = relabel(claim.gist, claim, root, labels)
    return f"{labels[claim.id]}{arrows(claim.why, labels)}: {gist}{suffix}"


def theory_block(
    theory: Theory, ledger: Ledger, labels: Mapping[str, str], depth: int = 0
) -> list[str]:
    """A theory and everything under it, as one nested list.

    Indentation is containment: a nested line reads in every word stipulated
    above it, which is what made the defining claim a claim in the first
    place. Siblings come in support order, so a line's premises are above it
    as well as outside it.
    """
    inside = {
        child.name: child for child in ledger.theories if child.container == theory.name
    }
    claims = {claim.id: claim for claim in theory.claims}
    opening = (
        claim_line(theory.defining, ledger.origin, labels)
        if theory.defining
        else f"{theory.label}?: no defining claim -- `{defining_claim(theory.path)}` is unwritten"
    )
    lines = ["  " * depth + f"* {opening}"]
    for item in in_support_order(
        {claim.id: tuple(prior.id for prior in claim.why) for claim in theory.claims}
        | {
            name: tuple(prior.id for prior in child.priors)
            for name, child in inside.items()
        }
    ):
        lines += (
            theory_block(inside[item], ledger, labels, depth + 1)
            if item in inside
            else [
                "  " * (depth + 1)
                + f"* {claim_line(claims[item], ledger.origin, labels)}"
            ]
        )
    return lines


def labels_of(ledger: Ledger) -> Mapping[str, str]:
    """What each claim is cited as: its label, wearing its sigil.

    Theories need no entry of their own -- a theory is cited by citing the
    claim that defines it, and that claim is in here like any other. The
    exception is the theory whose defining claim is unwritten: it is open,
    not absent, and a citation should show it that way rather than as a
    dangling path.

    A claim in another ledger has no label to show either -- reading it is
    outside what this render was pointed at -- but the citation is sound, so
    it keeps its path and says where the label went.
    """
    return (
        {
            theory.name: theory.cited_as
            for theory in ledger.theories
            if theory.defining is None
        }
        | {claim.id: claim.cited_as for claim in ledger.claims}
        | {other: f"(elsewhere: {other})" for other in foreign(ledger)}
    )


def lints(ledger: Ledger) -> tuple[str, ...]:
    """What the flattening loses or blurs, for stderr.

    Labels are the only handle the chat form has -- paths are gone -- so a
    label another label prefixes is a real collision here, however well the
    files were telling those two claims apart.
    """
    found = [f"dangling why: reference: {missing}" for missing in dangling(ledger)]
    # An unwritten defining claim needs no lint: the theory renders `?`, which
    # is the ledger's own way of saying nobody has signed it yet. A written one
    # that stipulates nothing is the defect -- it reads as settled and confines
    # no word.
    found += [
        f"{defining_claim(theory.path)} stipulates no `ontology:`;"
        " nothing confines the collection's claims"
        for theory in ledger.theories
        if theory.defining and not theory.ontology
    ]
    names = sorted(claim.label for claim in ledger.claims)
    found += [
        (
            f"label {one} is defined twice"
            if one == other
            else f"label {one} prefixes {other}; `grep {one}` cannot tell them apart"
        )
        for one, other in combinations(names, 2)
        if other.startswith(one)
    ]
    return tuple(found)


def counted(number: int, singular: str, plural: str) -> str:
    return f"{number} {singular}" if number == 1 else f"{number} {plural}"


def flatten(ledger: Ledger, source: Path) -> str:
    """The whole ledger as one nested list, outermost theory first."""
    confined = sum(len(theory.claims) for theory in ledger.theories)
    lines = [
        f"# {ledger.name} -- claim ledger",
        "",
        f"{counted(confined, 'claim', 'claims')} in"
        f" {counted(len(ledger.theories), 'theory', 'theories')}, from"
        f" `{source}` as of {date.today().isoformat()}.",
        "",
        LEGEND,
        "",
        *theory_block(ledger.theories[0], ledger, labels_of(ledger)),
    ]
    return "\n".join(lines).strip() + "\n"


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    _ = parser.add_argument("ledger", type=Path, help="a `*.claims.kb/` directory")
    args = parser.parse_args()
    root = cast(Path, args.ledger)

    ledger = read_ledger(root)
    for complaint in lints(ledger):
        print(f"{root}: {complaint}", file=sys.stderr)
    print(flatten(ledger, root), end="")


if __name__ == "__main__":
    main()
